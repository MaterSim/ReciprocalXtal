#############################################################
data_from_pyxtal

_symmetry_space_group_name_H-M 'P6422'
_symmetry_Int_Tables_number                  181
_symmetry_cell_setting                 hexagonal
_cell_length_a            3.526733
_cell_length_b            3.526733
_cell_length_c            4.028573
_cell_angle_alpha        90.000000
_cell_angle_beta         90.000000
_cell_angle_gamma       120.000000
_cell_volume             43.393741

loop_
 _symmetry_equiv_pos_site_id
 _symmetry_equiv_pos_as_xyz
1 'x, y, z'
2 '-y, x-y, z+1/3'
3 '-x+y, -x, z+2/3'
4 '-x, -y, z'
5 'y, -x+y, z+1/3'
6 'x-y, x, z+2/3'
7 'y, x, -z+1/3'
8 'x-y, -y, -z'
9 '-x, -x+y, -z+2/3'
10 '-y, -x, -z+1/3'
11 '-x+y, y, -z'
12 'x, x-y, -z+2/3'

loop_
 _atom_site_label
 _atom_site_type_symbol
 _atom_site_symmetry_multiplicity
 _atom_site_fract_x
 _atom_site_fract_y
 _atom_site_fract_z
 _atom_site_occupancy
Si     Si       3     0.500000    0.000000    0.000000 1
O      O        6     0.308065    0.616129    0.500000 1
#END

